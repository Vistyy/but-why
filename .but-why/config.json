{
  "idPrefix": "BY",
  "agentEnvironment": {
    "command": ["pnpm", "exec"]
  },
  "prepare": {
    "command": "pnpm install --frozen-lockfile --prefer-offline",
    "timeoutSeconds": 1200
  },
  "validation": {
    "checks": [
      {
        "id": "quality",
        "command": "just quality",
        "timeoutSeconds": 1200
      }
    ]
  },
  "review": {
    "specialists": ["removal", "standards"]
  },
  "reviewers": {
    "removal": {
      "instructionsFile": ".but-why/reviewers/removal.md",
      "agentProfile": { "scope": "global", "name": "reviewer" }
    },
    "standards": {
      "instructionsFile": ".but-why/reviewers/standards.md",
      "agentProfile": { "scope": "global", "name": "reviewer" }
    }
  }
}
