{
  "idPrefix": "BY",
  "agentEnvironment": {
    "command": ["nix", "develop", "-c", "pnpm", "exec"]
  },
  "prepare": {
    "command": "pnpm install --frozen-lockfile --prefer-offline",
    "timeoutSeconds": 1200
  },
  "validation": {
    "checks": [
      {
        "id": "quality",
        "command": "just quality",
        "timeoutSeconds": 1200
      }
    ]
  },
  "review": {
    "specialists": ["standards", "verification"]
  },
  "reviewers": {
    "standards": {
      "instructionsFile": ".but-why/reviewers/standards.md",
      "agentProfile": { "scope": "global", "name": "reviewer" }
    },
    "verification": {
      "instructionsFile": ".but-why/reviewers/verification.md",
      "agentProfile": { "scope": "global", "name": "reviewer" }
    }
  }
}
