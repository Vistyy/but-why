{
  "taskPrefix": "BY",
  "agentEnvironment": {
    "command": ["nix", "develop", "-c", "pnpm", "exec"]
  },
  "prepare": {
    "command": "pnpm install --frozen-lockfile --prefer-offline",
    "timeoutSeconds": 1200
  },
  "validation": {
    "checks": [
      {
        "id": "candidate-repo-config",
        "command": "just validate-candidate-repo-config",
        "timeoutSeconds": 120
      },
      {
        "id": "quality",
        "command": "just quality",
        "timeoutSeconds": 1200
      }
    ]
  },
  "review": {
    "specialists": ["standards"]
  },
  "reviewers": {
    "standards": {
      "instructionsFile": ".but-why/reviewers/standards.md",
      "agentProfile": { "scope": "global", "name": "reviewer" }
    }
  }
}
