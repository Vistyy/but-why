#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { accessSync, constants, realpathSync } from "node:fs";
import { dirname, join, resolve } from "node:path";

const repoDir = realpathSync(resolve(dirname(process.argv[1]), ".."));
const args = process.argv.slice(2);
const mainCheckout = findMainCheckout();

if (!mainCheckout.ok) {
  fail({
    code: "main_checkout_unavailable",
    message: "The Local Repository's canonical main checkout is unavailable.",
    ...(mainCheckout.path === undefined ? {} : { details: { path: mainCheckout.path } }),
    help: "Restore the canonical main checkout, then retry the command.",
  });
}

const trustedExecutable = join(mainCheckout.path, "bin/by");
try {
  accessSync(trustedExecutable, constants.X_OK);
} catch {
  fail({
    code: "trusted_executable_unavailable",
    message: "The canonical main-checkout Trusted But Why Executable is unavailable.",
    details: { path: trustedExecutable },
    help: "Restore the canonical main-checkout Trusted But Why Executable, then retry the command.",
  });
}

const child =
  repoDir === mainCheckout.path
    ? spawnSync(
        process.execPath,
        [
          "--import",
          join(repoDir, "node_modules/tsx/dist/loader.mjs"),
          join(repoDir, "src/main.ts"),
          ...args,
        ],
        {
          env: { ...process.env, BUT_WHY_EXECUTABLE_PATH: join(repoDir, "bin/by") },
          stdio: "inherit",
        },
      )
    : spawnSync(trustedExecutable, args, {
        env: { ...process.env, BUT_WHY_EXECUTABLE_PATH: trustedExecutable },
        stdio: "inherit",
      });

if (child.error !== undefined) {
  fail({
    code: "trusted_executable_unavailable",
    message: "The canonical main-checkout Trusted But Why Executable is unavailable.",
    details: { path: trustedExecutable },
    help: "Restore the canonical main-checkout Trusted But Why Executable, then retry the command.",
  });
}

process.exitCode = child.status ?? 1;

function findMainCheckout() {
  const worktrees = spawnSync("git", ["worktree", "list", "--porcelain", "-z"], {
    encoding: "buffer",
    stdio: ["ignore", "pipe", "ignore"],
  });
  if (worktrees.status !== 0 || worktrees.stdout === null) return { ok: false };

  const firstWorktree = worktrees.stdout.toString("utf8").split("\0\0", 1)[0] ?? "";
  const rawPath = firstWorktree
    .split("\0")
    .find((field) => field.startsWith("worktree "))
    ?.slice("worktree ".length);
  if (rawPath === undefined || rawPath.length === 0) return { ok: false };

  try {
    return { ok: true, path: realpathSync(rawPath) };
  } catch {
    return { ok: false, path: rawPath };
  }
}

function fail(failure) {
  const result = {
    error: {
      code: failure.code,
      message: failure.message,
      ...(failure.details ?? {}),
    },
    help: [failure.help],
  };
  process.stdout.write(`${JSON.stringify(result)}\n`);
  process.exit(1);
}
