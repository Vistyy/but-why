{
  "name": "@syzom/but-why",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "by": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "effect-tsgo patch --oxlint --no-typescript && biome check --error-on-warnings . && oxlint --config oxlint.config.ts .",
    "format-check": "biome format ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@effect/tsgo": "0.45.0",
    "@syzom/typescript-quality": "0.5.0",
    "@types/node": "24.0.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "1.2.1",
    "typescript": "7.0.2",
    "vitest": "3.2.6"
  }
}
