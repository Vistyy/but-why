{
  "name": "but-why",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "by": "./dist/main.js"
  },
  "files": [
    "dist",
    "extensions",
    "docs/public",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vistyy/but-why.git"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "just build",
    "docs-check": "remark --frail --quiet",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "lint": "biome lint .",
    "ast-grep-check": "ast-grep test --skip-snapshot-tests && ast-grep scan",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@biomejs/biome": "^2.2.0",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@effect/vitest": "0.28.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "3.2.6",
    "fallow": "^3.2.0",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "rolldown": "1.2.1",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ast-grep/cli",
      "@parcel/watcher",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
