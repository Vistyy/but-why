{
  "description": "Comparative cold-start measurements for the production executable and installed package tarball.",
  "method": {
    "processesPerCommand": 15,
    "order": "randomized",
    "comparison": ["compiledExecutable", "installedPackageTarball"]
  },
  "commands": [
    ["--help"],
    ["--version"],
    ["task", "list"],
    ["change", "list"],
    ["validation-run", "show", "missing"]
