{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/config-schema.json",
  "entry": ["src/main.ts", "extensions/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "ignoreDependencies": [
    "@ai-hero/sandcastle",
    "@effect/cli",
    "@effect/experimental",
    "@effect/platform",
    "@effect/platform-node",
    "@effect/sql",
    "@earendil-works/pi-coding-agent",
    "effect"
  ],
  "ignorePatterns": ["spikes/**", "dist/**", "build/**", "coverage/**"],
  "rulePacks": ["./fallow-rules/architecture.json"],
  "rules": {
    "boundary-violation": "error",
    "circular-dependencies": "error",
    "dev-dependencies-in-production": "off",
    "duplicate-exports": "error",
    "policy-violation": "error",
    "re-export-cycle": "error",
    "require-suppression-reason": "error",
    "stale-suppressions": "error",
    "test-only-dependencies": "error",
    "type-only-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "unused-class-members": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-enum-members": "error",
    "unused-exports": "error",
    "unused-files": "error",
    "unused-optional-dependencies": "error",
    "unused-types": "error"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "boundaries": {
    "zones": [
      {
        "name": "cli",
        "patterns": ["src/cli.ts", "src/cli*.ts", "src/cli/**"]
      },
      {
        "name": "domain",
        "patterns": [
          "src/change/candidate/candidate.ts",
          "src/change/change.ts",
          "src/change/implementationBlocker.ts",
          "src/change/implementationDecision.ts",
          "src/change/validationRun/cleanup.ts",
          "src/change/validationRun/acceptanceContextSnapshot.ts",
          "src/change/validationRun/toolingErrorKind.ts",
          "src/change/validationRun/validationRun.ts",
          "src/task/lifecycle.ts",
          "src/task/task.ts",
          "src/task/taskId.ts"
        ]
      },
      {
        "name": "composition",
        "patterns": [
          "src/change/**/composition/**",
          "src/change/composition/**",
          "src/repositorySnapshot/composition/**",
          "src/task/composition/**"
        ]
      },
      {
        "name": "repository-runtime",
        "patterns": ["src/repositoryRuntime/**"]
      },
      {
        "name": "storage",
        "patterns": ["src/sqlite/**"]
      },
      {
        "name": "adapters",
        "patterns": [
          "src/agent/piReviewerProcessExecutor.ts",
          "src/change/changeStartGit.ts",
          "src/change/interactiveSession/herdrInteractiveSessionHost.ts",
          "src/change/interactiveSession/localInteractiveSessionProfile.ts",
          "src/change/localChangeCleanupGit.ts",
          "src/change/candidateCapture/localGitCandidate.ts",
          "src/change/publication/localCandidatePublicationGit.ts",
          "src/change/validation/validationWorkspaceCleanupGit.ts",
          "src/repositoryPreparation/localRepositoryPreparation.ts",
          "src/submissionEnvironment/gitFacts.ts",
          "src/submissionEnvironment/githubTarget.ts",
          "src/submissionEnvironment/localGitHubPullRequestGateway.ts",
          "src/submissionEnvironment/remoteChangeBase.ts",
          "src/submissionEnvironment/repositoryFile.ts",
          "src/disposableWorkspace/disposableWorkspaceGit.ts",
          "src/disposableWorkspace/workspaceRuntimeAdapter.ts",
          "src/init/git.ts",
          "src/init/gitignore.ts",
          "src/init/globalConfig.ts",
          "src/init/repoConfig.ts"
        ]
      },
      {
        "name": "behavior",
        "patterns": ["src/change/**", "src/repositorySnapshot/**", "src/task/**"]
      }
    ],
    "rules": [
      {
        "from": "cli",
        "allow": ["behavior", "composition", "domain", "repository-runtime"]
      },
      {
        "from": "domain",
        "allow": []
      },
      {
        "from": "repository-runtime",
        "allow": ["adapters", "storage"]
      },
      {
        "from": "behavior",
        "allow": ["domain"],
        "allowTypeOnly": ["adapters", "repository-runtime"]
      }
    ]
  }
}
