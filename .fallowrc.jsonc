{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/config-schema.json",
  "entry": [
    ".remarkrc.mjs",
    "extensions/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "src/main.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "ignoreDependencies": [
    "@effect/cli",
    "@effect/experimental",
    "@effect/platform",
    "@effect/platform-node",
    "@effect/sql",
    "@earendil-works/pi-coding-agent",
    "effect"
  ],
  "ignorePatterns": ["spikes/**", "dist/**", "build/**", "coverage/**"],
  "rules": {
    "boundary-violation": "error",
    "circular-dependencies": "error",
    "dev-dependencies-in-production": "off",
    "duplicate-exports": "error",
    "re-export-cycle": "error",
    "require-suppression-reason": "error",
    "stale-suppressions": "error",
    "test-only-dependencies": "error",
    "type-only-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "unused-class-members": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-enum-members": "error",
    "unused-exports": "error",
    "unused-files": "error",
    "unused-optional-dependencies": "error",
    "unused-types": "error"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "maxUnitSize": 60
  },
  "boundaries": {
    "coverage": {
      "requireAllFiles": true
    },
    "zones": [
      {
        "name": "adapters",
        "patterns": ["src/**/adapters/**", "src/sqlite/**"]
      },
      {
        "name": "task-composition",
        "patterns": ["src/task/composition/**"]
      },
      {
        "name": "change-composition",
        "patterns": ["src/change/**/composition/**"]
      },
      {
        "name": "repository-runtime-composition",
        "patterns": ["src/repositorySnapshot/composition/**"]
      },
      {
        "name": "cli",
        "patterns": ["src/cli.ts", "src/cli*.ts", "src/cli/**", "src/main.ts"]
      },
      {
        "name": "task",
        "patterns": ["src/task/**"]
      },
      {
        "name": "change",
        "patterns": ["src/agent/**", "src/change/**"]
      },
      {
        "name": "repository-runtime",
        "patterns": ["src/repositoryRuntime/**", "src/repositorySnapshot/**"]
      },
      {
        "name": "shared",
        "patterns": [
          "src/command/**",
          "src/contracts/**",
          "src/disposableWorkspace/**",
          "src/init/**",
          "src/output/**",
          "src/repositoryPreparation/**",
          "src/submissionEnvironment/**"
        ]
      },
      {
        "name": "support",
        "patterns": [".remarkrc.mjs", "extensions/**", "scripts/**", "test/**", "vitest.config.ts"]
      }
    ],
    "rules": [
      {
        "from": "adapters",
        "allow": ["change", "repository-runtime", "shared", "task"]
      },
      {
        "from": "task-composition",
        "allow": ["adapters", "repository-runtime", "shared", "task"]
      },
      {
        "from": "change-composition",
        "allow": ["adapters", "change", "repository-runtime", "shared", "task"]
      },
      {
        "from": "repository-runtime-composition",
        "allow": ["adapters", "repository-runtime", "shared"]
      },
      {
        "from": "cli",
        "allow": [
          "change",
          "change-composition",
          "repository-runtime",
          "repository-runtime-composition",
          "shared",
          "task",
          "task-composition"
        ]
      },
      {
        "from": "task",
        "allow": ["repository-runtime", "shared"]
      },
      {
        "from": "change",
        "allow": ["repository-runtime", "shared", "task"]
      },
      {
        "from": "repository-runtime",
        "allow": ["adapters", "shared"]
      },
      {
        "from": "shared",
        "allow": []
      },
      {
        "from": "support",
        "allow": [
          "adapters",
          "change",
          "change-composition",
          "cli",
          "repository-runtime",
          "repository-runtime-composition",
          "shared",
          "task",
          "task-composition"
        ]
      }
    ]
  }
}
